struct private object {
  num size;
  str label;
}

class public dog {
  num age;

  str describe() {
    print("age={self.age}\n");
    return("done");
  }
}

fn public main() {
  num x = 2;
  num y = x + 4;
  print("Y: {y} \n");
  str greeting = "hello" + " jot";
  print(greeting);
  print("\n");
  print(len(greeting));
  print("\n");
  object car = new object(200, "fast");
  print(car.size);
  print("\n");
  dog d = new dog(3);
  print(d.describe());
  print("\n");
  return(0);
}

main();