fn public total(arr xs) {
  num sum = 0;
  for (x in xs) {
    sum = sum + x;
  }
  return(sum);
}

fn public first(arr xs) {
  return(xs[0]);
}

fn public main() {
  arr nums = [4, 5, 6];
  print(total(nums));
  print("\n");
  print(first(nums));
  print("\n");
  arr alias = nums;
  alias[2] = 60;
  print(nums[2]);
  print("\n");
  return(0);
}

main();