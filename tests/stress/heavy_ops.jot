// Stress: heavy mixed ops — big (non-trapping) ints, floats, array
// load/store loop, string concat, conversions, break/continue.
fn public main() {
  num big = 4000000000;
  big = big + 123456789;
  big = big - 42;
  big = big * 2;
  print(big);
  print("\n");
  num f = 3.5;
  f = f * 2.0 + 1.25;
  f = f / 4.0 - 0.5;
  print(f);
  print("\n");
  arr a = [0, 0, 0, 0, 0, 0, 0, 0];
  num i = 0;
  while (i < 100000) {
    i += 1;
    if (i == 50000) {
      continue;
    }
    if (i > 90000) {
      break;
    }
    a[0] = i;
    a[1] = a[0] + 1;
    a[2] += 2;
  }
  print(a[0]);
  print("\n");
  print(a[1]);
  print("\n");
  print(a[2]);
  print("\n");
  str s = "a";
  num k = 0;
  while (k < 500) {
    s = s + "b";
    k += 1;
  }
  print(len(s));
  print("\n");
  num n = tonum("2.75");
  print(tostr(n + 1));
  print("\n");
  return(0);
}

main();
